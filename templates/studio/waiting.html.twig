{% block content %}
<div class="video-studio">
    <p class="video-notice">{{ 'studio.waiting.lead'|trans }}</p>
    <p><a class="video-button" href="{{ path('video_studio_uploaded', {uploadId: upload_id}) }}">{{ 'studio.waiting.again'|trans }}</a> <a class="video-button" href="{{ path('video_studio') }}">{{ 'studio.nav.videos'|trans }}</a></p>
</div>
{% endblock %}
