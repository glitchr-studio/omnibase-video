{% extends 'layout1.html.twig' %}
{% trans_default_domain 'video' %}
{% block title %}{{ 'studio.link.title'|trans }}{% endblock %}
{% block content %}
<div class="video-studio">
    <header class="video-page-head"><h1>{{ 'studio.link.title'|trans }}</h1></header>
    {% include '@Video/studio/_nav.html.twig' %}
    <p class="video-lead">{{ 'studio.link.lead'|trans }}</p>
    {{ form_start(form, {attr: {class: 'video-form video-panel'}}) }}{{ form_widget(form) }}<button type="submit" class="video-button video-button--accent">{{ 'studio.link.submit'|trans }}</button>{{ form_end(form) }}
</div>
{% endblock %}
